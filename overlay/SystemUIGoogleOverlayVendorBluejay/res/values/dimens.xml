<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">0dp</dimen>

    <!-- Padding for the lock icon on the keyguard. In pixels - should not scale with display size. -->
    <dimen name="lock_icon_padding">56px</dimen>

    <!-- Margin on the left side of the carrier text on Keyguard -->
    <dimen name="keyguard_carrier_text_margin">0px</dimen>

    <!-- The maximum offset for the under-display fingerprint sensor (UDFPS) icon in either
         direction that elements are moved to prevent burn-in on AOD-->
    <dimen name="udfps_burn_in_offset_y">16px</dimen>

    <!-- Location on the screen of the center of the physical power button. This is a reasonable
    default that should be overridden by device-specific overlays. -->
    <dimen name="physical_power_button_center_screen_location_y">650px</dimen>

    <!-- Default device corner radius, used for assist UI -->
    <dimen name="config_rounded_mask_size">47px</dimen>
    <dimen name="config_rounded_mask_size_top">47px</dimen>
    <dimen name="config_rounded_mask_size_bottom">46px</dimen>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">56.5</item>
</resources>
